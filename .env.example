# Copy to .env and fill in values

DJANGO_SECRET_KEY=change-me-to-something-random
DEBUG=true
ALLOWED_HOSTS=localhost 127.0.0.1

# Point at the folder holding your RAG scripts (builder.py, etc.)
# Default: ./rag  (drop scripts there)
RAG_DIR=./rag

# Where finished .faiss + .pkl pairs are saved
INDEX_DIR=./indexes

# Scratch folder for PDF uploads
UPLOAD_DIR=./uploads

# Max PDF size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# Firecrawl key – move it out of crawler.py and set it here
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
